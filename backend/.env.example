SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
# Local Docker Compose MongoDB service (keep this for local development):
MONGODB_URI=mongodb://spotify-mongo:27017/spotify-prototype
# Production (MongoDB Atlas): set MONGODB_URI to your Atlas SRV connection string
# Example format only — do not commit real credentials:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development
# Frontend origin for OAuth redirects and CORS (production example: https://music.soli.nyc)
FRONTEND_URL=http://localhost:5173
# Required long random string for signed session cookies (set a unique value in Render)
SESSION_SECRET=
