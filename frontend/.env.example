# Leave empty for local Docker development so requests use the Vite proxy.
# In production (Netlify), set this to the public API origin (https://api.soli.nyc).
# Production builds use this for both axios API calls and Spotify OAuth redirects.
VITE_API_BASE_URL=

# Local Docker only: absolute backend origin for full-page OAuth (/login, /reauthorize).
# Ignored in production builds (Vite PROD uses VITE_API_BASE_URL instead).
VITE_BACKEND_ORIGIN=http://localhost:3000
